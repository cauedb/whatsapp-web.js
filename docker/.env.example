# Copy this file to `.env` in the repo root (next to docker-compose.yml) and
# adjust as needed. docker compose loads it automatically.

# Distinguishes session folders if you ever run multiple clients against the
# same volume. Leave unset for a single instance.
# WWEBJS_CLIENT_ID=

# Point at an already-running CDP-compatible browser (e.g. Obscura, or a
# remote Chrome) instead of launching the Chrome bundled in the image.
# Leave unset to use the bundled Chrome. See docker/README.md#obscura.
# BROWSER_WS_ENDPOINT=ws://obscura:9222/devtools/browser

# Comma-separated extra Chrome flags, only used when BROWSER_WS_ENDPOINT is
# unset (i.e. when launching the bundled Chrome).
# PUPPETEER_ARGS=

# HTTP API (opt-in) — set API_PORT to start it. See docker/README.md#http-api.
# API_PORT=3000

# Required if API_PORT is set — startup fails without it, since the API
# controls a real WhatsApp account.
# API_KEY=

# Where to POST incoming-message events (e.g. an n8n Webhook node URL, or a
# Python http.server/Flask endpoint). Leave unset to skip forwarding.
# WEBHOOK_URL=

# Comma-separated chat IDs to restrict webhook forwarding to (see msg.from
# in docker/README.md#http-api for the format). Leave unset to forward
# messages from every chat.
# WEBHOOK_CHAT_IDS=5511999999999@c.us,120363012345678901@g.us
